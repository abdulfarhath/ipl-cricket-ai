# One LLM key needed for chat/api modes. ETL, index, and MCP work without any key.
# Option A (FREE tier, no card): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your-key-here
# Option B (paid): https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# LLM_PROVIDER=gemini            # gemini | claude (auto-detected from keys if unset)
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_MODEL=claude-opus-5
EMBED_MODEL=BAAI/bge-m3
# Low-RAM alternative:
# EMBED_MODEL=BAAI/bge-small-en-v1.5
