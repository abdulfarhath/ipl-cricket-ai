# --- LLM (one required for chat; ingestion/stats/MCP work without any key) ---
# Free tier, no card: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-lite-latest
LLM_PROVIDER=gemini            # gemini | openai (openai = any OpenAI-compatible: vLLM, Ollama)
# OPENAI_BASE_URL=http://vllm:8000/v1
# OPENAI_API_KEY=...
# OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- infrastructure (docker-compose overrides these automatically) ---
DATABASE_URL=postgresql://ipl:ipl@localhost:5433/ipl
REDIS_URL=redis://localhost:6380/0
POSTGRES_PASSWORD=change-me-in-production

DATA_CUTOFF=2025-12-31
EMBED_MODEL=BAAI/bge-small-en-v1.5
CACHE_TTL_S=3600
